// ConnectionSrings is used for DigitalShop database connection string configuration.
// Its like using DATABASE_URL in Python or other languages.
{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DigitalShop.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ApplicationSettings": {
    "JWT_Secret": "this_is_my_dummy_secret_for_development_mode"
  },
  "AllowedHosts": "*"
}
